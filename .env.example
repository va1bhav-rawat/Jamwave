# ---- apps/server ----
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
# YouTube Data API v3 key (Google Cloud console). Optional in dev: without it,
# search is disabled but pasting YouTube links still works via oEmbed.
YOUTUBE_API_KEY=
# Minutes an empty room survives before it is deleted
ROOM_EMPTY_TTL_MINUTES=10
# Seconds a disconnected participant can reclaim their seat (and host role)
RECLAIM_GRACE_SECONDS=60
# Per-participant searches per minute, and the global daily search budget
SEARCH_RATE_PER_MINUTE=10
SEARCH_DAILY_CAP=95
# Abuse protection: per-IP limits on creating / joining jams, and a hard cap on live rooms
ROOM_CREATE_RATE_PER_MINUTE=5
ROOM_JOIN_RATE_PER_MINUTE=30
MAX_ROOMS=5000
# Proxies in front of the server (Render/Fly/Vercel = 1; 0 when clients hit the server directly).
# The client address is read that many entries from the end of x-forwarded-for.
TRUST_PROXY_HOPS=1
MAX_CONNECTIONS_PER_IP=20
LOG_LEVEL=info

# ---- apps/web ----
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public contact shown on the privacy page (defaults to vaibhavr325@gmail.com).
NEXT_PUBLIC_CONTACT_EMAIL=
